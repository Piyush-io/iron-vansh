---
import { site } from '../data/site';
interface Props { heading?: string; lede?: string }
const {
  heading = 'Enquiries',
  lede = 'For investment enquiries and information on our strategies, please contact our office.',
} = Astro.props;
---
<section class="sx-contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap g12">
    <h2 class="lbl" id="contact-title">{heading.replace(/\.$/, '')}</h2>
    <div class="sx-body">
      <p class="sx-statement">{lede}</p>
      <dl class="sx-cdl">
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Phone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
        <div><dt>Office</dt><dd>{site.address}</dd></div>
      </dl>
    </div>
  </div>
</section>
