---
import { products } from '../data/products';
import Globe from './Globe.astro';
---
<div class="panels" id="panels">
  {products.map((p, i) => (
    <a class:list={['panel', { 'is-open': i === 0, latius: p.slug === 'latius' }]} id={p.slug} href={`/products/${p.slug}`}>
      <div class="media">
        {p.image ? <img src={p.image} alt="" loading="lazy" /> : <Globe />}
      </div>
      <div class="inner">
        <span class="where">{p.where}</span>
        <h3 class="d2">{p.name}</h3>
        {p.status ? <span class="status">{p.status}</span> : <span class="reg">{p.reg?.replace(/ \(.*\)$/, '')}</span>}
        <div class="more"><div>
          <p>{p.panelBlurb}</p>
          <ul>{p.tags.map((t) => <li>{t}</li>)}</ul>
          <span class="textlink">Read about {p.name}</span>
        </div></div>
      </div>
    </a>
  ))}
</div>
