---
import type { Product } from '../data/products';
interface Props { items: Product[] }
const { items } = Astro.props;
---
{items.map((p) => (
  <div class="alloc">
    <h3>{p.name}<small>{p.alloc.sub}</small></h3>
    <div class="alloc-bar" role="img" aria-label={p.alloc.aria}>
      {p.alloc.segs.map((s) => (
        <div class={`seg ${s.cls}`} style={`flex:${s.flex}`}><span><b>{s.strong}</b>{s.label}</span></div>
      ))}
    </div>
  </div>
))}
