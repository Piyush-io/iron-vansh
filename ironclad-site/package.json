{
  "name": "ironclad-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "review": "npm run build && node scripts/create-review.mjs",
    "photos": "node scripts/fetch-photos.mjs",
    "predev": "node scripts/fetch-photos.mjs --soft",
    "prebuild": "node scripts/fetch-photos.mjs --soft",
    "drop": "npm run build && rm -f ironclad-site-vercel.zip && cd dist && zip -qr ../ironclad-site-vercel.zip . -x '.htaccess' '*.DS_Store'",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "basic-ftp": "6.2.1",
    "sharp": "^0.35.5"
  }
}
