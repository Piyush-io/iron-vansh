{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/product.html", "destination": "/products/pms/", "permanent": true },
    { "source": "/media.html", "destination": "/media/", "permanent": true },
    { "source": "/investor-update.html", "destination": "/investor-update/", "permanent": true },
    { "source": "/contact.html", "destination": "/contact/", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy/", "permanent": true },
    { "source": "/blog-single.html", "destination": "/blogs/", "permanent": true },
    { "source": "/about.html", "destination": "/team/", "permanent": true },
    {
      "source": "/login.html",
      "destination": "https://onlinefa.icici.bank.in/wealthspectrum/portal/sign-in",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(woff2|webp|png|jpg|jpeg|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
