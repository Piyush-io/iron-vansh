---
// Blackstone page header: serif title left, short description right, then a contained photograph.
import Photo from './Photo.astro';
import type { PhotoName } from '../data/photos';
interface Props { title: string; summary?: string; where?: string; reg?: string; status?: string; photo?: PhotoName; position?: string }
const { title, summary, where, reg, status, photo, position } = Astro.props;
---
<section class="page-header">
  <div class="wrap page-header__inner">
    <div class="page-header__title-col">
      {where && <p class="eyebrow page-header__eyebrow">{where}</p>}
      <h1 class="page-header__title">{title.replace(/\.$/, '')}</h1>
    </div>
    {(summary || reg || status) && (
      <div class="page-header__desc">
        {summary && <p>{summary}</p>}
        {reg && <p class="page-header__meta">{reg}</p>}
        {status && <p class="status">{status}</p>}
      </div>
    )}
  </div>
</section>
{photo && <div class="wrap hero-media"><Photo name={photo} eager decorative sizes="(max-width: 1440px) 100vw, 1264px" position={position} /></div>}
