---
import type { Product } from '../data/products';
import Ranges from './Ranges.astro';
interface Props { alloc: NonNullable<Product['alloc']> }
const { alloc } = Astro.props;
---
<div class="alloc">
  <p class="alloc-sub">{alloc.sub}</p>
  <Ranges segs={alloc.segs} aria={alloc.aria} large key />
</div>
