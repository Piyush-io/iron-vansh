---
// Blackstone's circled arrow: ring, arrow, and a solid fill that shows on hover.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class:list={['bx-icon', className]} width="40" height="40" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path class="bx-icon__arrow" fill="currentColor" d="M29 20c0-.2 0-.4-.2-.6l-4.4-4.6a1 1 0 0 0-1.2 0c-.3.3-.3.8 0 1.1l3.1 3.3H11.8a.8.8 0 1 0 0 1.6h14.5l-3 3.3c-.4.3-.4.8 0 1.2.3.3.8.2 1.1 0l4.4-4.7.2-.6Z"/><path class="bx-icon__fill" fill="currentColor" d="M20 0a20 20 0 1 1 0 40 20 20 0 0 1 0-40Zm3.2 14.8c-.3.3-.3.8 0 1.1l3.1 3.3H11.8a.8.8 0 1 0 0 1.6h14.5l-3 3.3c-.4.3-.4.8 0 1.2.3.3.8.2 1.1 0l4.4-4.7.2-.6c0-.2 0-.4-.2-.6l-4.4-4.6a1 1 0 0 0-1.2 0Z"/><path class="bx-icon__ring" fill="currentColor" d="M20 0a20 20 0 1 0 0 40 20 20 0 0 0 0-40Zm0 1.5a18.5 18.5 0 1 1 0 37 18.5 18.5 0 0 1 0-37Z"/></svg>
