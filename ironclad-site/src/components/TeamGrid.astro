---
import { team } from '../data/team';
interface Props { full?: boolean }
const { full = false } = Astro.props;
---
<div class:list={['people', { page: full }]}>
  {team.map((p, i) => (
    <article class:list={['person', { lead: i === 0 }]}>
      <figure><img src={p.image} alt={p.name} loading="lazy" /></figure>
      {i === 0 ? (
        <div>
          <h3>{p.name}</h3>
          <p>{p.title}</p>
          <p class="bio">{full ? p.bio : p.shortBio}</p>
          <a class="textlink" href={p.linkedin} rel="noopener" target="_blank">LinkedIn</a>
        </div>
      ) : (
        <>
          <h3>{p.name}</h3>
          {p.title && <p>{p.title}</p>}
          <a class="textlink" href={p.linkedin} rel="noopener" target="_blank">LinkedIn</a>
        </>
      )}
    </article>
  ))}
</div>
