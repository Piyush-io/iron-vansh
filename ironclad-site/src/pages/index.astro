---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import BlogList from '../components/BlogList.astro';
import Photo from '../components/Photo.astro';
import TeamGrid from '../components/TeamGrid.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Go from '../components/Go.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { productPhoto } from '../data/photos';
const hasPosts = (await getCollection('blog')).length > 0;
const market = { pms: 'Indian listed equities', ventures: 'Venture-backed startups', latius: 'Global equities' } as const;
const shortReg = { pms: 'PMS', ventures: 'Category I AIF', latius: 'GIFT City' } as const;
const slides = [
  { photo: 'harbour' as const, position: '50% 58%', title: 'Our Investment Philosophy', blurb: 'We believe exceptional investing begins with understanding the world around a business and then understanding the business itself.', href: '#approach' },
  ...products.map((p) => ({ photo: productPhoto[p.slug], position: '50% 55%', title: p.name, blurb: p.intro.paras[0], href: `/products/${p.slug}` })),
];
---
<Base dark>
  <section class="promo-header is-dark" aria-labelledby="hero-title">
    <div class="wrap promo-header__inner">
      <h1 class="promo-header__title" id="hero-title">
        <span class="promo-header__t1"><strong class="w" style="--i:0">Ironclad</strong> <span class="w" style="--i:1">Asset</span></span>
        <span class="promo-header__t2"><span class="w" style="--i:2">Management</span></span>
      </h1>
      <p class="promo-header__desc intro" style="--i:3">A multi-asset investment firm across Indian listed equities, venture-backed startups and global markets.</p>
    </div>
  </section>

  <section class="carousel is-dark" data-carousel aria-roledescription="carousel" aria-label="Featured">
    <div class="wrap carousel__inner">
      <div class="carousel__viewport">
        <div class="carousel__track">
          {slides.map((sl, k) => (
            <article class="carousel__slide" aria-roledescription="slide" aria-label={`${k + 1} of ${slides.length}`}>
              <div class="carousel__media"><Photo name={sl.photo} eager={k === 0} decorative sizes="(max-width: 1440px) 100vw, 1264px" position={sl.position} /></div>
              <div class="carousel__main">
                <div class="carousel__title-col">
                  <h2 class="carousel__title">{sl.title}</h2>
                  <div class="carousel__nav">
                    <button type="button" class="carousel__btn carousel__btn--prev" data-go="prev" aria-label="Show previous slide"><ArrowIcon /></button>
                    <ul class="dots">{slides.map((d, j) => <li><a href={`#slide-${j + 1}`} data-go={j} data-i={j} aria-label={`Go to slide ${d.title}`}></a></li>)}</ul>
                    <button type="button" class="carousel__btn" data-go="next" aria-label="Show next slide"><ArrowIcon /></button>
                  </div>
                </div>
                <div class="carousel__content">
                  <p class="carousel__blurb">{sl.blurb}</p>
                  <Go href={sl.href} />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="offerings" aria-labelledby="belief-title">
    <div class="wrap">
      <div class="offerings__heading">
        <span class="divider" aria-hidden="true"></span>
        <p class="eyebrow-plain">About the Firm</p>
        <h2 class="offerings__title" id="belief-title">Capital, Conviction &amp; Compounding</h2>
      </div>
      <div class="offerings__main">
        <h3 class="offerings__sub">Intellectual. Fundamental. Strategic.</h3>
        <div class="offerings__content">
          <p>Exceptional outcomes rarely emerge from conventional thinking. We combine <strong>Intellectual</strong> curiosity, <strong>Fundamental</strong> depth and <strong>Strategic</strong> oversight to identify mispriced possibilities, navigate complexity in capital markets and allocate capital where the risk-reward opportunity is the greatest.</p>
          <div class="offerings__cta"><Go href="/team" /></div>
        </div>
        <div class="offerings__stat">
          <p class="stat__value">3</p>
          <p class="stat__label">Investment Products</p>
          <p class="stat__note">Two SEBI-registered. Ironclad Latius’ IFSCA licence is under application.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="two-up is-dark" id="products" aria-labelledby="strategy-title">
    <div class="wrap two-up__inner">
      <p class="eyebrow two-up__eyebrow">Our Products</p>
      <h2 class="two-up__title" id="strategy-title">Our Three Products</h2>
      <p class="two-up__copy">Indian listed equities, India’s venture-backed startups and global equities through GIFT City. One research discipline across all three.</p>
      <div class="two-up__cta"><Go href="#compare" label="Compare Products" /></div>
      <div class="two-up__links">
        <ul>
          {products.map((p) => (
            <li><a class="two-up__link" href={`/products/${p.slug}`}><span>{p.name} ({shortReg[p.slug]})</span><ArrowIcon /></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="ticker is-dark" aria-label="Capital, Conviction and Compounding">
    <div class="ticker__inner" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1, 2, 3].map(() => <p class="ticker__title"><strong>Capital,</strong> Conviction &amp; Compounding</p>)}
      </div>
    </div>
    <div class="wrap ticker__disclaimer"><p>Investments in securities markets are subject to market risks. Read all related documents carefully before investing.</p></div>
  </section>

  <section class="compare" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <p class="eyebrow">At a Glance</p>
      <h2 class="section-title" id="compare-title">How the products compare</h2>
      <div class="mandates">
        <div class="m-labels" aria-hidden="true"><span></span><span>Portfolio</span><span>Construction</span><span>Invests in</span><span></span></div>
        {products.map((p) => (
          <article class="m-col" aria-labelledby={`m-${p.slug}`}>
            <header class="m-head">
              <span class="m-market">{market[p.slug]}</span>
              <h3 id={`m-${p.slug}`}>{p.name}</h3>
              <span class:list={['status-line', p.compare.status]}>{p.compare.status === 'pending' ? 'Licence under application' : 'SEBI-registered'}</span>
            </header>
            <div class="m-figure" data-label="Portfolio">
              <p><b>{p.compare.figure}</b> <span>{p.compare.figureLabel}</span></p>
              <p class="m-detail">{p.compare.detail}</p>
            </div>
            <div class="m-build" data-label="Construction">
              {p.alloc ? (
                <>
                  <span class="alloc-bar" role="img" aria-label={p.alloc.aria}>{p.alloc.segs.map((s) => <span class={`seg ${s.cls}`} style={`flex:${s.flex}`}></span>)}</span>
                  <ul class="m-legend">{p.alloc.segs.map((s) => <li><span><i class={`sw ${s.cls}`}></i>{s.label}</span><b>{s.strong}</b></li>)}</ul>
                </>
              ) : (
                <ul class="m-stages">{p.compare.stages?.map((t) => <li>{t}</li>)}</ul>
              )}
            </div>
            <div class="m-where" data-label="Invests in">
              <p>{p.where}</p>
              <p class="m-reg">{p.compare.regShort}</p>
            </div>
            <Go class="m-link" href={`/products/${p.slug}`} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="vlist" id="approach" aria-labelledby="philosophy-title">
    <div class="wrap">
      <p class="eyebrow">Our Investment Philosophy</p>
      <h2 class="vlist__statement" id="philosophy-title">Top-down perspective. Bottom-up conviction.</h2>
      <div class="vlist__inner">
        <div class="vlist__image"><Photo name="desk" decorative sizes="(max-width: 900px) 100vw, 620px" position="50% 50%" /></div>
        <div class="vlist__content">
          <div class="vlist__item">
            <h3>Our process</h3>
            <p>We believe exceptional investing begins with understanding the world around a business and then understanding the business itself. Our process combines <strong>top-down analysis of macroeconomic regimes, sector tailwinds and headwinds, structural shifts, industry dynamics and capital flows</strong> with <strong>bottom-up fundamental research</strong> into individual businesses. We study financial statements, earnings quality, cash flows, return on capital, competitive advantages, management quality, balance-sheet strength and valuation to determine what a business is truly worth.</p>
          </div>
          <div class="vlist__item">
            <h3>Our principles</h3>
            <p>Our philosophy draws inspiration from the enduring principles of investors such as <strong>Warren Buffett, Charlie Munger, Seth Klarman and Chuck Akre</strong>: own exceptional businesses, understand intrinsic value, demand a margin of safety, and allow superior economics to compound over time. We look beyond headline growth to examine <strong>the quality, durability and reinvestment potential of that growth</strong>. We ask what can go right, what can go wrong, what the market is pricing in and where our differentiated understanding creates an edge.</p>
          </div>
          <div class="vlist__item">
            <h3>Our view of markets</h3>
            <p>Markets are complex, adaptive and constantly evolving. We approach them with intellectual curiosity, rigorous research and a willingness to challenge consensus looking beyond the obvious to identify patterns, dislocations and emerging inflection points before they become widely understood.</p>
            <ul class="tenets">
              <li><b>Fundamentals</b> inform the thesis.</li>
              <li><b>Macro</b> shapes the context.</li>
              <li><b>Valuation</b> determines the opportunity.</li>
              <li><b>Discipline</b> determines the outcome.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="people-section" id="people" aria-labelledby="team-title">
    <div class="wrap">
      <p class="eyebrow">Our People</p>
      <div class="split-head">
        <h2 class="section-title" id="team-title">The People Behind Ironclad</h2>
        <p class="split-head__desc">Built by investors with experience across investing, entrepreneurship, strategy and global capital markets.</p>
      </div>
      <TeamGrid />
    </div>
  </section>

  {hasPosts && <section class="writing-section"><div class="wrap"><p class="eyebrow">News &amp; Insights</p><h2 class="section-title">Investment perspectives</h2><BlogList limit={3} /><p class="people-more"><Go href="/blogs" label="Read All Insights" /></p></div></section>}
  <ContactBand />
</Base>
