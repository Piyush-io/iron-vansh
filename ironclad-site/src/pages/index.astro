---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import BlogList from '../components/BlogList.astro';
import Photo from '../components/Photo.astro';
import Crest from '../components/Crest.astro';
import { site } from '../data/site';
import { team } from '../data/team';
import { products } from '../data/products';
const founder = team[0];
const hasPosts = (await getCollection('blog')).length > 0;
---
<Base>
  <section class="capital-hero" aria-labelledby="hero-title">
    <div class="capital-hero-image"><Photo name="pavilion" eager sizes="100vw" /></div>
    <div class="capital-hero-shade"></div>
    <div class="wrap capital-hero-content">
      <h1 id="hero-title">Built for<br />the long term.</h1>
      <p>Independent thinking. Patient capital.<br />Investing in Indian and global businesses with the mindset of an owner.</p>
      <div class="capital-hero-actions"><a class="button button-gold" href="#strategies">Explore our strategies</a><a class="hero-secondary" href="/team">Meet the firm</a></div>
    </div>
    <div class="wrap capital-hero-bottom">
      <span class="hero-geography">India at our core.<br />The world in our view.</span>
      <a class="hero-credentials" href="/disclosures"><Crest /><span><strong>SEBI-registered investment management</strong><span>Portfolio Manager {site.registrations.pms}</span><span>Category I AIF {site.registrations.aif}</span></span></a>
    </div>
  </section>

  <section class="firm-intro" aria-labelledby="intro-title">
    <div class="wrap firm-intro-layout"><h2 id="intro-title">Conviction begins with<br />knowing the business.</h2><p>We bring an owner's discipline to investing. Understand how a business earns, what can go wrong, and what it is worth. Then give it time.</p></div>
  </section>

  <section class="strategy-section" id="strategies" aria-labelledby="strategy-title">
    <div class="wrap">
      <div class="strategy-section-heading"><h2 id="strategy-title">One philosophy.<br />Three distinct mandates.</h2><p>Access different opportunities through strategies with clear investment mandates.</p></div>
      <div class="strategy-canvas">
        <a class="strategy-tile strategy-public" href="/products/pms">
          <Photo name="mumbai" sizes="(max-width: 760px) 100vw, 55vw" decorative />
          <div class="tile-shade"></div>
          <div class="tile-content"><span class="tile-market">Indian listed equities</span><h3>Ironclad PMS</h3><p>A flexicap portfolio investing across small-, mid- and large-cap businesses.</p><span class="tile-action">View the PMS mandate</span><small>SEBI Portfolio Manager</small></div>
        </a>
        <a class="strategy-tile strategy-private" href="/products/ventures">
          <div class="tile-content"><span class="tile-market">Indian private companies</span><h3>Ironclad<br />Ventures</h3><p>Secondary investments in proven, venture-backed businesses.</p><span class="tile-action">View the Ventures mandate</span></div>
          <div class="tile-photo"><Photo name="ventures" sizes="(max-width: 760px) 40vw, 20vw" decorative /></div>
        </a>
        <a class="strategy-tile strategy-global" href="/products/latius">
          <div class="tile-content"><span class="tile-market">Global equities</span><h3>Ironclad Latius</h3><p>Investing beyond India through a GIFT City-based strategy.</p><span class="tile-action">View the Latius mandate</span><small>IFSCA licence under application</small></div>
          <div class="tile-photo"><Photo name="global" sizes="(max-width: 760px) 40vw, 20vw" decorative /></div>
        </a>
      </div>
      <details class="portfolio-comparison"><summary>Compare portfolio construction <span class="comparison-toggle" aria-hidden="true"></span></summary><div class="portfolio-comparison-grid">{products.map(p => <div><h3>{p.name}</h3><p>{p.buildIntro}</p><div class="mandate-allocation" role="img" aria-label={p.alloc.aria}>{p.alloc.segs.map(segment => <span class={`allocation-segment ${segment.cls}`} style={`flex:${segment.flex}`}></span>)}</div><ul class="allocation-legend" aria-hidden="true">{p.alloc.segs.map(segment => <li><span class={`allocation-swatch ${segment.cls}`}></span><span>{segment.label}<b>{segment.strong}</b></span></li>)}</ul></div>)}</div></details>
    </div>
  </section>

  <section class="ownership-section" id="approach" aria-labelledby="approach-title">
    <div class="wrap"><div class="ownership-shell">
      <div class="ownership-intro"><h2 id="approach-title">We take the time<br />to understand<br />what we own.</h2><p>Research, valuation, and risk management guide the decisions we make with investors' capital.</p><a class="button button-outline" href="/contact">Talk through our approach</a></div>
      <div class="ownership-principles">
        <article><h3>Look beyond the quarter</h3><p>We assess what a business can earn over a decade, and the management decisions that will shape it.</p></article>
        <article><h3>Know the downside</h3><p>We weigh business risk and valuation before investing. Position sizing matters through every market cycle.</p></article>
        <article><h3>Stay close to the business</h3><p>Our experience as investors and operators informs the questions we ask and how we review our investments.</p></article>
      </div>
    </div></div>
  </section>

  <section class="people-section" aria-labelledby="team-title">
    <div class="wrap people-layout">
      <figure class="founder-photograph"><img src={founder.image} alt={founder.name} width="900" height="1202" loading="lazy" /><figcaption><strong>{founder.name}</strong><span>{founder.title}</span></figcaption></figure>
      <div class="people-copy"><h2 id="team-title">Experienced investors.<br />An owner's perspective.</h2><p>{founder.bio}</p><p>Meet the people researching businesses and managing Ironclad's investment strategies.</p><div class="team-preview">{team.slice(1).map(person => <a href="/team"><img src={person.image} alt="" width="64" height="76" loading="lazy" /><span>{person.name}</span></a>)}</div><a class="button button-dark" href="/team">Meet the investment team</a></div>
    </div>
  </section>

  {hasPosts && <section class="writing-section"><div class="wrap"><div class="writing-heading"><h2>Investment perspectives</h2><a class="textlink" href="/blogs">Read all insights</a></div><BlogList limit={3} /></div></section>}
  <ContactBand />
</Base>
