---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import BlogList from '../components/BlogList.astro';
import Photo from '../components/Photo.astro';
import TeamGrid from '../components/TeamGrid.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { productPhoto } from '../data/photos';
const hasPosts = (await getCollection('blog')).length > 0;
const cardPos = { pms: '50% 50%', ventures: '50% 40%', latius: '50% 50%' } as const;
const market = { pms: 'Indian listed equities', ventures: 'Venture-backed startups', latius: 'Global equities' } as const;
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-top">
      <div class="hero-copy">
        <h1 class="display" id="hero-title" data-reveal>Built for the<br />long term.</h1>
      </div>
      <div class="hero-side" data-reveal style="--d:140ms">
        <p class="lead">Independent thinking. Patient capital. We invest in Indian and global businesses with the mindset of an owner.</p>
        <div class="actions"><a class="btn btn-primary" href="#strategies">Explore our strategies</a><a class="btn btn-secondary" href="/team">Meet the firm</a></div>
      </div>
    </div>
    <div class="wrap">
      <div class="hero-panel" data-reveal style="--d:200ms">
        <div class="hero-media" data-drift="0.06" aria-hidden="true"><Photo name="dawn" eager decorative sizes="(max-width: 1440px) 100vw, 1440px" position="50% 60%" /></div>
        <ul class="hero-links glass">
          {products.map((p) => (
            <li><a href={`/products/${p.slug}`}><span class="mono">{market[p.slug]}</span><b>{p.name}</b><Arrow class="go" diagonal /></a></li>
          ))}
        </ul>
      </div>
      <dl class="reg-strip" data-reveal>
        <div><dt>SEBI PMS</dt><dd>{site.registrations.pms}</dd></div>
        <div><dt>SEBI Category I AIF</dt><dd>{site.registrations.aif}</dd></div>
        <div><dt>Ironclad Latius</dt><dd>IFSCA licence under application</dd></div>
      </dl>
    </div>
  </section>

  <section class="statement-section" aria-label="Our approach in brief">
    <div class="wrap">
      <p class="eyebrow" data-reveal><span class="dot"></span>How we invest</p>
      <p class="statement" data-statement>We bring an owner's discipline to investing. Understand how a business earns, what can go wrong, and what it is worth. Then give it time.</p>
    </div>
  </section>

  <section class="numbers-section" aria-label="Ironclad at a glance">
    <div class="wrap">
      <dl class="numbers">
        <div class="num" data-reveal><dt class="mono">Mandates</dt><dd><b>3</b><span>Indian listed equities, venture-backed startups and global equities.</span></dd></div>
        <div class="num" data-reveal style="--d:70ms"><dt class="mono">SEBI registrations</dt><dd><b>2</b><span>Portfolio Manager and Category I Alternative Investment Fund.</span></dd></div>
        <div class="num" data-reveal style="--d:140ms"><dt class="mono">Flexicap+ portfolio</dt><dd><b>15<i>–</i>20</b><span>Carefully selected companies across large-, mid- and small-cap.</span></dd></div>
        <div class="num" data-reveal style="--d:210ms"><dt class="mono">Founder experience</dt><dd><b>15<i>+</i></b><span>Years across private equity, consulting and entrepreneurship.</span></dd></div>
      </dl>
    </div>
  </section>

  <section class="strategy-section" id="strategies" aria-labelledby="strategy-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal><span class="dot"></span>Strategies</p>
        <h2 id="strategy-title" data-reveal style="--d:70ms">One philosophy.<br />Three distinct mandates.</h2>
        <p class="lede" data-reveal style="--d:140ms">Three strategies with clear mandates: Indian listed equities, India’s venture-backed startups, and global equities through GIFT City.</p>
      </div>
      <div class="strategy-grid">
        {products.map((p, i) => (
          <a class="s-card" href={`/products/${p.slug}`} data-reveal style={`--d:${i * 90}ms`}>
            <Photo name={productPhoto[p.slug]} decorative sizes="(max-width: 900px) 200vw, 85vw" position={cardPos[p.slug]} />
            <div class="s-body">
              <span class="mono">{market[p.slug]}</span>
              <h3>{p.name}</h3>
              <p>{p.panelBlurb}</p>
              <span class="s-foot"><span class="s-status">{p.status ?? p.reg?.replace(/ \(.*\)$/, '')}</span><span class="chip-arrow"><Arrow /></span></span>
            </div>
          </a>
        ))}
      </div>

      <div class="compare" role="table" aria-label="Strategy comparison" data-reveal>
        <div class="compare-row compare-head" role="row">
          <span role="columnheader" class="mono">Strategy</span><span role="columnheader" class="mono">Invests in</span><span role="columnheader" class="mono">Portfolio construction</span><span role="columnheader" class="mono">Regulation</span>
        </div>
        {products.map((p) => (
          <a class="compare-row" role="row" href={`/products/${p.slug}`}>
            <span role="cell" class="c-name" data-label="Strategy">{p.name}</span>
            <span role="cell" data-label="Invests in">{p.where}</span>
            <span role="cell" class="c-alloc" data-label="Portfolio construction">
              <span class="c-summary">{p.portfolioSummary}</span>
              {p.alloc && <span class="alloc-bar" role="img" aria-label={p.alloc.aria}>{p.alloc.segs.map((s) => <span class={`seg ${s.cls}`} style={`flex:${s.flex}`}></span>)}</span>}
              {p.alloc && <span class="alloc-legend" aria-hidden="true">{p.alloc.segs.map((s) => <span><i class={`sw ${s.cls}`}></i>{s.label} <b>{s.strong}</b></span>)}</span>}
            </span>
            <span role="cell" data-label="Regulation">{p.status ?? p.reg?.replace(/ \(.*\)$/, '')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="approach-section" id="approach" aria-labelledby="approach-title">
    <div class="wrap approach-layout">
      <div class="approach-intro">
        <p class="eyebrow" data-reveal><span class="dot"></span>Approach</p>
        <h2 id="approach-title" data-reveal style="--d:70ms">We take the time to understand what we own.</h2>
        <p class="lede" data-reveal style="--d:140ms">Research, valuation, and risk management guide the decisions we make with investors' capital.</p>
        <a class="btn btn-secondary" href="/contact" data-reveal style="--d:210ms">Talk through our approach</a>
      </div>
      <ol class="principles">
        <li data-reveal><div><h3>Look beyond the quarter</h3><p>We assess what a business can earn over a decade, and the management decisions that will shape it.</p></div></li>
        <li data-reveal style="--d:80ms"><div><h3>Know the downside</h3><p>We weigh business risk and valuation before investing. Position sizing matters through every market cycle.</p></div></li>
        <li data-reveal style="--d:160ms"><div><h3>Stay close to the business</h3><p>Our experience as investors and operators informs the questions we ask and how we review our investments.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="interlude" aria-label="India at our core">
    <div class="interlude-media" data-drift="0.1" aria-hidden="true"><Photo name="manhattan" decorative sizes="100vw" position="50% 55%" class="interlude-img" /></div>
    <div class="wrap">
      <div class="interlude-card glass" data-reveal>
        <p class="eyebrow"><span class="dot"></span>Geography</p>
        <p class="interlude-line">India at our core.<br />The world in our view.</p>
      </div>
    </div>
  </section>

  <section class="people-section" aria-labelledby="team-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal><span class="dot"></span>The firm</p>
        <h2 id="team-title" data-reveal style="--d:70ms">Experienced investors.<br />An owner's perspective.</h2>
        <p class="lede" data-reveal style="--d:140ms">Meet the people researching businesses and managing Ironclad's investment strategies.</p>
      </div>
      <TeamGrid />
      <p class="people-more" data-reveal><a class="btn btn-secondary" href="/team">Meet the investment team</a></p>
    </div>
  </section>

  {hasPosts && <section class="writing-section"><div class="wrap"><div class="sec-head"><p class="eyebrow"><span class="dot"></span>Insights</p><h2>Investment perspectives</h2></div><BlogList limit={3} /><p class="people-more"><a class="btn btn-secondary" href="/blogs">Read all insights</a></p></div></section>}
  <ContactBand />
</Base>
