---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AllocationBars from '../../components/AllocationBars.astro';
import PerformanceNote from '../../components/PerformanceNote.astro';
import ContactBand from '../../components/ContactBand.astro';
import { products } from '../../data/products';
import { productPhoto } from '../../data/photos';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props;
const others = products.filter((o) => o.slug !== p.slug);
---
<Base title={p.name} description={p.metaDescription}>
  <PageHero
    title={p.name}
    where={p.where}
    reg={p.reg}
    status={p.status}
    summary={p.heroSummary}
    photo={productPhoto[p.slug]}
    position={p.slug === 'pms' ? '30% 58%' : p.slug === 'latius' ? '66% 50%' : '60% 50%'}
  />

  <section class="section" aria-labelledby="invest-title">
    <div class="wrap">
      <div class="head">
        <h2 class="d2" id="invest-title">What we invest in</h2>
        <div class="prose">
          {p.invest.map((t) => <p class="lede">{t}</p>)}
          <div class="focus">
            <h3>{p.focusHeading}</h3>
            <ul>{p.focus.map((f) => <li>{f}</li>)}</ul>
          </div>
          {p.slug === 'ventures' && <p class="small note">The fund is sector-agnostic and may invest opportunistically elsewhere.</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="build-title">
    <div class="wrap">
      <div class="head">
        <h2 class="d2" id="build-title">How the portfolio is built</h2>
        <p class="lede">{p.buildIntro}</p>
      </div>
      <AllocationBars items={[p]} />
    </div>
  </section>

  <section class="section" aria-labelledby="points-title">
    <div class="wrap">
      <div class="head">
        <h2 class="d2" id="points-title">Key points</h2>
      </div>
      <div class="keypoints">
        {p.keyPoints.map((k) => (
          <div class="kp"><h3>{k.title}</h3><p>{k.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <PerformanceNote claims={p.claims} />

  <ContactBand heading={`Enquiries about ${p.name}.`} />

  <section class="others" aria-labelledby="others-title">
    <div class="wrap">
      <h2 class="d3 sec-title" id="others-title">Our other strategies</h2>
      <ul>
        {others.map((o) => (
          <li><a href={`/products/${o.slug}`}><b>{o.name}</b><span>{o.status ?? o.where}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
