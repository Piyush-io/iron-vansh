---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AllocationBars from '../../components/AllocationBars.astro';
import PerformanceNote from '../../components/PerformanceNote.astro';
import ContactBand from '../../components/ContactBand.astro';
import { products } from '../../data/products';
import { productPhoto } from '../../data/photos';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props;
const others = products.filter((o) => o.slug !== p.slug);
const position = p.slug === 'pms' ? '50% 64%' : p.slug === 'latius' ? '50% 42%' : '50% 70%';
const portfolioTitle = p.alloc?.title ?? p.construction?.title ?? 'Portfolio';
---
<Base title={p.name} description={p.metaDescription}>
  <PageHero title={p.name} where={p.kicker} reg={p.reg} status={p.status} summary={p.headline} photo={productPhoto[p.slug]} position={position} />

  <section class="section" aria-labelledby="intro-title">
    <div class="wrap head">
      <h2 class="d2" id="intro-title">{p.intro.title}</h2>
      <div class="prose">{p.intro.paras.map((t) => <p class="lede">{t}</p>)}</div>
    </div>
  </section>

  {p.sections.map((sec, i) => (
    <section class="section rule" aria-labelledby={`sec-${i}`}>
      <div class="wrap">
        <div class="sec-head"><h2 id={`sec-${i}`}>{sec.title}</h2></div>
        <div class="keypoints">
          {sec.items.map((k, j) => (
            <div class="kp">
              <h3>{k.title}</h3>
              {k.text && <p>{k.text}</p>}
              {k.bullets && <ul class="bullets">{k.bullets.map((b) => <li>{b}</li>)}</ul>}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  {(p.alloc || p.construction || p.chips) && (
    <section class="section alt" aria-labelledby="build-title">
      <div class="wrap head">
        <h2 class="d2" id="build-title">{portfolioTitle}</h2>
        <div class="build">
          {p.alloc && <AllocationBars alloc={p.alloc} />}
          {p.construction && <ul class="bullets bullets-lg">{p.construction.bullets.map((b) => <li>{b}</li>)}</ul>}
          {p.chips && (
            <div class="focus">
              <h3>{p.chips.title}</h3>
              <ul>{p.chips.items.map((f) => <li>{f}</li>)}</ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="why-title">
    <div class="wrap head">
      <h2 class="d2" id="why-title">{p.why.title}</h2>
      <ul class="checklist">{p.why.bullets.map((b) => <li>{b}</li>)}</ul>
    </div>
  </section>

  <section class="philosophy" aria-labelledby="philo-title">
    <div class="wrap">
      <p class="label" id="philo-title">Our philosophy</p>
      <blockquote class="philosophy-line">{p.philosophy}</blockquote>
      <p class="philosophy-by">Ironclad Asset Management</p>
    </div>
  </section>

  <PerformanceNote claims={p.claims} />

  <aside class="risk" aria-label="Risk disclosure">
    <div class="wrap"><p><b>Risk disclosure.</b> {p.risk}</p></div>
  </aside>

  <ContactBand heading={`Enquiries about ${p.name}.`} />

  <section class="others" aria-labelledby="others-title">
    <div class="wrap">
      <h2 class="d3 sec-title" id="others-title">Our other products</h2>
      <ul>
        {others.map((o) => (
          <li><a href={`/products/${o.slug}`}><b>{o.name}</b><span>{o.kicker}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
