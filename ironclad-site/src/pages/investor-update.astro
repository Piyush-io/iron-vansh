---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
// Monthly notes for Ironclad PMS investors. Edited in the CMS (/admin → Investor updates); newest first.
import data from '../data/investor-updates.json';
type Update = { title: string; summary: string; points?: string[]; file: string };
// a blank "Key points" box in the CMS must not become an empty bullet
const updates = (data.items as Update[]).map((u) => ({ ...u, points: u.points?.filter((t) => t?.trim()) }));
const href = (f: string) => encodeURI(f);
---
<Base title="Investor Update" description="Monthly investor updates for Ironclad PMS.">
  <PageHero title="Investor Update." summary="Monthly notes to Ironclad PMS investors on markets, the portfolio and our thinking." />
  <section class="section rule">
    <div class="wrap">
      <ul class="doclist">
        {updates.map((u) => (
          <li><a href={href(u.file)} target="_blank" rel="noopener">
            <span class="label">PDF</span>
            <div><h3>{u.title}</h3><p>{u.summary}</p>{u.points?.length ? <ul class="points">{u.points.map((t) => <li>{t}</li>)}</ul> : null}</div>
            <span class="go-text">Read PDF</span>
          </a></li>
        ))}
      </ul>
      <p class="small note">Past performance does not indicate future results. Investments in securities markets are subject to market risks.</p>
    </div>
  </section>
</Base>
