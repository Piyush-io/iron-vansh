---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, mapsUrl } from '../data/site';
---
<Base title="Contact" description="Contact Ironclad Asset Management: office address, phone, email and investor login." darkHero={true}>
  <PageHero title="Contact." summary="For investment enquiries and information on our strategies, please contact our office in Noida." crest />
  <section class="section" aria-label="Contact details">
    <div class="wrap">
      <dl class="rows">
        <div class="row"><dt>Office</dt><dd>{site.address}<br><a class="textlink" href={mapsUrl} rel="noopener" target="_blank">View on Google Maps</a></dd></div>
        <div class="row"><dt>Phone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
        <div class="row"><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div class="row"><dt>Existing investors</dt><dd><a class="textlink" href={site.investorLoginUrl} rel="noopener" target="_blank">Investor login</a></dd></div>
      </dl>
    </div>
  </section>
</Base>
