---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
// Press coverage. Edited in the CMS (/admin → Media coverage); newest first.
import data from '../data/press.json';
const press: { outlet: string; url: string; text: string }[] = data.items;
---
<Base title="Media" description="Press coverage of Ironclad Asset Management.">
  <PageHero title="Media." summary="Ironclad Asset Management in the press." />
  <section class="section rule">
    <div class="wrap">
      <ul class="doclist">
        {press.map((m) => (
          <li><a href={m.url} target="_blank" rel="noopener">
            <span class="label">{m.outlet}</span>
            <div><p class="press-text">{m.text}</p></div>
            <span class="go-text">Read article</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
