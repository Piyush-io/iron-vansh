---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found.">
  <section class="notfound">
    <div class="wrap">
      <h1 class="display">That page isn’t here.</h1>
      <p class="lede">It may have moved, or the address may be mistyped.</p>
      <a class="textlink" href="/">Return to the homepage</a>
    </div>
  </section>
</Base>
