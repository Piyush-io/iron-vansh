---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InvestorAwareness from '../components/InvestorAwareness.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; darkHero?: boolean }
const { title, description = site.description, darkHero = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/png" href="/images/logo-navy.png">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#0B5546">
  <meta property="og:image" content={new URL('/images/ironclad-pavilion-v3-1672.webp', Astro.site)}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://images.unsplash.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class:list={{ home: Astro.url.pathname === '/' }}>
  <a class="skip" href="#main">Skip to content</a>
  <Header darkHero={darkHero} pathname={Astro.url.pathname} />
  <main id="main">
    <slot />
  </main>
  <InvestorAwareness />
  <Footer />
  <script is:inline>
    (() => {
      const header = document.getElementById('header');
      // Products dropdown: click and keyboard, closes on outside click / Escape
      const dd = document.getElementById('dd'), ddBtn = dd.querySelector('button');
      const setDD = open => { dd.toggleAttribute('data-open', open); ddBtn.setAttribute('aria-expanded', open); };
      ddBtn.addEventListener('click', () => setDD(!dd.hasAttribute('data-open')));
      dd.addEventListener('mouseenter', () => matchMedia('(hover:hover)').matches && setDD(true));
      dd.addEventListener('mouseleave', () => matchMedia('(hover:hover)').matches && setDD(false));
      dd.addEventListener('focusout', e => { if (!dd.contains(e.relatedTarget)) setDD(false); });
      document.addEventListener('click', e => { if (!dd.contains(e.target)) setDD(false); });

      // Mobile drawer
      const drawer = document.getElementById('drawer'), openBtn = document.getElementById('open'), closeBtn = document.getElementById('close');
      const background = [header, document.getElementById('main'), document.querySelector('.awareness'), document.querySelector('.site-footer')];
      const setDrawer = open => {
        drawer.toggleAttribute('data-open', open);
        drawer.inert = !open;
        drawer.setAttribute('aria-hidden', String(!open));
        openBtn.setAttribute('aria-expanded', String(open));
        background.forEach(el => { if (el) el.inert = open; });
        document.body.style.overflow = open ? 'hidden' : '';
        (open ? closeBtn : openBtn).focus();
      };
      openBtn.addEventListener('click', () => setDrawer(true));
      closeBtn.addEventListener('click', () => setDrawer(false));
      drawer.querySelectorAll('nav a').forEach(a => a.addEventListener('click', () => setDrawer(false)));
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          if (dd.hasAttribute('data-open')) { setDD(false); ddBtn.focus(); }
          if (drawer.hasAttribute('data-open')) setDrawer(false);
        }
        if (e.key === 'Tab' && drawer.hasAttribute('data-open')) {
          const focusable = [...drawer.querySelectorAll('a[href], button')];
          const first = focusable[0], last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
      matchMedia('(min-width:901px)').addEventListener('change', e => { if (e.matches && drawer.hasAttribute('data-open')) setDrawer(false); });

      // Product panels: hover or focus widens one panel (desktop only)
      const panels = [...document.querySelectorAll('.panel')];
      const wide = matchMedia('(min-width:901px)');
      const openPanel = p => { if (!wide.matches) return; panels.forEach(x => x.classList.toggle('is-open', x === p)); };
      panels.forEach(p => { p.addEventListener('mouseenter', () => openPanel(p)); p.addEventListener('focus', () => openPanel(p)); });
    })();
  </script>
</body>
</html>
