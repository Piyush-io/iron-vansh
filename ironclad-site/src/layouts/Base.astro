---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InvestorAwareness from '../components/InvestorAwareness.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; darkHero?: boolean }
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/png" href="/images/logo-navy.png">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={new URL('/images/og.jpg', Astro.site)}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#ffffff">
  <link rel="preload" href="/fonts/tinos-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body class:list={{ home: isHome }}>
  <a class="skip" href="#main">Skip to content</a>
  <Header pathname={Astro.url.pathname} />
  <main id="main">
    <slot />
  </main>
  <InvestorAwareness />
  <Footer />
  <script is:inline>
    (() => {
      const header = document.getElementById('header');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Products dropdown: click and keyboard, closes on outside click / Escape
      const dd = document.getElementById('dd'), ddBtn = dd.querySelector('button');
      const setDD = open => { dd.toggleAttribute('data-open', open); ddBtn.setAttribute('aria-expanded', open); };
      ddBtn.addEventListener('click', () => setDD(!dd.hasAttribute('data-open')));
      dd.addEventListener('mouseenter', () => matchMedia('(hover:hover)').matches && setDD(true));
      dd.addEventListener('mouseleave', () => matchMedia('(hover:hover)').matches && setDD(false));
      dd.addEventListener('focusout', e => { if (!dd.contains(e.relatedTarget)) setDD(false); });
      document.addEventListener('click', e => { if (!dd.contains(e.target)) setDD(false); });

      // Mobile drawer
      const drawer = document.getElementById('drawer'), openBtn = document.getElementById('open'), closeBtn = document.getElementById('close');
      const background = [header, document.getElementById('main'), document.querySelector('.awareness'), document.querySelector('.site-footer')];
      const setDrawer = open => {
        drawer.toggleAttribute('data-open', open);
        drawer.inert = !open;
        drawer.setAttribute('aria-hidden', String(!open));
        openBtn.setAttribute('aria-expanded', String(open));
        background.forEach(el => { if (el) el.inert = open; });
        document.body.style.overflow = open ? 'hidden' : '';
        (open ? closeBtn : openBtn).focus();
      };
      openBtn.addEventListener('click', () => setDrawer(true));
      closeBtn.addEventListener('click', () => setDrawer(false));
      drawer.querySelectorAll('nav a').forEach(a => a.addEventListener('click', () => setDrawer(false)));
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          if (dd.hasAttribute('data-open')) { setDD(false); ddBtn.focus(); }
          if (drawer.hasAttribute('data-open')) setDrawer(false);
        }
        if (e.key === 'Tab' && drawer.hasAttribute('data-open')) {
          const focusable = [...drawer.querySelectorAll('a[href], button')];
          const first = focusable[0], last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
      matchMedia('(min-width:901px)').addEventListener('change', e => { if (e.matches && drawer.hasAttribute('data-open')) setDrawer(false); });

      // Scroll reveals. Content is visible by default; this only runs when JS and motion are available.
      const items = [...document.querySelectorAll('[data-reveal]')];
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach(el => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(entries => entries.forEach(en => {
          if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
        }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        items.forEach(el => {
          if (el.getBoundingClientRect().top < innerHeight) return el.classList.add('is-in');
          el.classList.add('will-rise');
          io.observe(el);
        });
      }

      // Statement: words resolve from grey to ink as the section scrolls through
      const statements = [...document.querySelectorAll('[data-statement]')].map(el => {
        const words = el.textContent.trim().split(/\s+/);
        el.setAttribute('aria-label', words.join(' '));
        el.innerHTML = words.map(w => `<span class="w" aria-hidden="true">${w}</span>`).join(' ');
        return { el, spans: [...el.querySelectorAll('.w')] };
      });

      // Parallax and header state, one rAF-throttled scroll handler
      const drift = [...document.querySelectorAll('[data-drift]')];
      let ticking = false;
      const update = () => {
        ticking = false;
        const y = window.scrollY, vh = window.innerHeight;
        header.classList.toggle('is-scrolled', y > 8);
        if (reduce) { statements.forEach(s => s.spans.forEach(w => w.classList.add('on'))); return; }
        statements.forEach(({ el, spans }) => {
          const r = el.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (vh * 0.86 - r.top) / (r.height + vh * 0.38)));
          const n = Math.round(p * spans.length);
          spans.forEach((w, i) => w.classList.toggle('on', i < n));
        });
        drift.forEach(el => {
          const r = el.parentElement.getBoundingClientRect();
          if (r.bottom < -100 || r.top > vh + 100) return;
          const k = parseFloat(el.dataset.drift) || 0.08;
          const py = Math.max(-60, Math.min(60, (r.top + r.height / 2 - vh / 2) * -k));
          el.style.setProperty('--py', py.toFixed(1));
        });
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      update();
    })();
  </script>
</body>
</html>
