---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; dark?: boolean }
const { title, description = site.description, dark = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/png" href="/images/logo-navy.png">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={new URL('/images/og.jpg', Astro.site)}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content={dark ? '#000000' : '#ffffff'}>
  <link rel="preload" href="/fonts/noto-serif-display-300.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/public-sans-300.woff2" as="font" type="font/woff2" crossorigin>
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body class:list={{ home: isHome, 'theme-dark': dark }}>
  <a class="skip" href="#main">Skip to content</a>
  <Header pathname={Astro.url.pathname} dark={dark} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script is:inline>
    (() => {
      const header = document.getElementById('header');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Products dropdown: click and keyboard, closes on outside click / Escape
      const dd = document.getElementById('dd'), ddBtn = dd.querySelector('button');
      const setDD = open => { dd.toggleAttribute('data-open', open); ddBtn.setAttribute('aria-expanded', open); };
      ddBtn.addEventListener('click', () => setDD(!dd.hasAttribute('data-open')));
      dd.addEventListener('mouseenter', () => matchMedia('(hover:hover)').matches && setDD(true));
      dd.addEventListener('mouseleave', () => matchMedia('(hover:hover)').matches && setDD(false));
      dd.addEventListener('focusout', e => { if (!dd.contains(e.relatedTarget)) setDD(false); });
      document.addEventListener('click', e => { if (!dd.contains(e.target)) setDD(false); });

      // Mobile drawer
      const drawer = document.getElementById('drawer'), openBtn = document.getElementById('open'), closeBtn = document.getElementById('close');
      const background = [header, document.getElementById('main'), document.querySelector('.site-footer')];
      const setDrawer = open => {
        drawer.toggleAttribute('data-open', open);
        drawer.inert = !open;
        drawer.setAttribute('aria-hidden', String(!open));
        openBtn.setAttribute('aria-expanded', String(open));
        background.forEach(el => { if (el) el.inert = open; });
        document.body.style.overflow = open ? 'hidden' : '';
        (open ? closeBtn : openBtn).focus();
      };
      openBtn.addEventListener('click', () => setDrawer(true));
      closeBtn.addEventListener('click', () => setDrawer(false));
      drawer.querySelectorAll('nav a').forEach(a => a.addEventListener('click', () => setDrawer(false)));
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          if (dd.hasAttribute('data-open')) { setDD(false); ddBtn.focus(); }
          if (drawer.hasAttribute('data-open')) setDrawer(false);
        }
        if (e.key === 'Tab' && drawer.hasAttribute('data-open')) {
          const focusable = [...drawer.querySelectorAll('a[href], button')];
          const first = focusable[0], last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
      matchMedia('(min-width:901px)').addEventListener('change', e => { if (e.matches && drawer.hasAttribute('data-open')) setDrawer(false); });

      // Header: sits in the page; once scrolled past, it slides back in (fixed) whenever you scroll up.
      const bar = document.getElementById('header-bar');
      let lastY = scrollY;
      const onScroll = () => {
        const y = scrollY, past = y > header.offsetHeight;
        bar.classList.toggle('is-fixed', past);
        bar.classList.toggle('is-shown', past && y < lastY);
        lastY = y;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Scroll reveals: content fades up, photos open with a curtain. Elements are tagged here (never in markup),
      // so the page is fully visible without JS. Siblings get a stagger index.
      if (!reduce && 'IntersectionObserver' in window) {
        const revealSel = [
          'main .eyebrow', 'main .eyebrow-plain', 'main .divider', 'main h2', 'main .split-head__desc', 'main .lede',
          '.offerings__sub', '.offerings__content', '.offerings__stat', '.two-up__copy', '.two-up__cta', '.two-up__links li',
          '.cmp__card', '.vlist__item', '.tenets li', '.founder-body', '.associate', '.team-title', '.kp', '.checklist li',
          '.bullets-lg li', '.focus', '.alloc', '.philosophy-line', '.philosophy-by', '.capture__copy', '.capture__fields div',
          '.doclist li', '.post', '.disc', '.rows .row', '.reg-table', '.legal-text > *', '.prose .lede', '.ticker__disclaimer',
          '.page-header__desc', '.linklist li', '.carousel__main',
          '.site-footer__col', '.site-footer__bottom',
        ].join(',');
        const curtainSel = '.carousel__media, .hero-media, .vlist__image, .founder figure, .associate figure';
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            // open a photo only once it has decoded, so it never wipes in half-loaded
            const img = e.target.matches('[data-curtain]') && e.target.querySelector('img');
            const show = () => e.target.classList.add('in');
            if (img && !img.complete) { img.loading = 'eager'; img.decode().then(show, show); } else show();
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        document.querySelectorAll(revealSel).forEach((el) => {
          if (el.closest('.promo-header')) return;
          const sibs = [...el.parentElement.children].filter((c) => c.matches(revealSel));
          el.style.setProperty('--d', String(Math.min(sibs.indexOf(el), 5)));
          el.dataset.reveal = '';
          io.observe(el);
        });
        document.querySelectorAll(curtainSel).forEach((el) => { el.dataset.curtain = ''; io.observe(el); });
      }

      // Carousels: prev/next buttons and dots; inactive slides are inert.
      document.querySelectorAll('[data-carousel]').forEach((root) => {
        const track = root.querySelector('.carousel__track');
        const slides = [...root.querySelectorAll('.carousel__slide')];
        let i = 0;
        const go = (n) => {
          i = (n + slides.length) % slides.length;
          track.style.transform = `translateX(${-100 * i}%)`;
          slides.forEach((s, k) => { s.inert = k !== i; s.setAttribute('aria-hidden', String(k !== i)); });
          root.querySelectorAll('.dots a').forEach((d) => d.toggleAttribute('aria-current', +d.dataset.i === i));
        };
        root.addEventListener('click', (e) => {
          const b = e.target.closest('[data-go]');
          if (!b) return;
          e.preventDefault();
          const v = b.dataset.go;
          go(v === 'prev' ? i - 1 : v === 'next' ? i + 1 : +v);
        });
        go(0);
      });
    })();
  </script>
</body>
</html>
